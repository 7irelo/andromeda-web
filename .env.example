# ============================================================
# Andromeda – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Django
# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start with DEBUG=False and a placeholder key.
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=False
# Public origin of the web app (used in password-reset links)
FRONTEND_URL=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200
# Behind TLS, also set: SECURE_SSL_REDIRECT=True and SECURE_HSTS_SECONDS=31536000
# Hide the admin behind a non-default path
ADMIN_URL=admin/
ALLOWED_HOSTS=localhost,127.0.0.1,django
CORS_ALLOWED_ORIGINS=http://localhost:4200

# PostgreSQL
POSTGRES_DB=andromeda
POSTGRES_USER=andromeda
POSTGRES_PASSWORD=andromeda_secret

# Neo4j
NEO4J_PASSWORD=andromeda_secret

# Redis
REDIS_PASSWORD=redis_secret

# RabbitMQ
RABBITMQ_USER=andromeda
RABBITMQ_PASSWORD=andromeda_secret

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Andromeda <noreply@andromeda.social>

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_secret

# Flower (Celery dashboard): required, it holds task arguments
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-flower

# MinIO object storage
MINIO_ROOT_USER=andromeda
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_EXTERNAL_URL=http://localhost:4200/media

# AI service. Provider keys are passed only to the internal ai container.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Speech-to-text and text-to-speech (voice notes, video captions, voice assistant)
DEEPGRAM_API_KEY=

# Web Push. Generate with: docker compose exec django python manage.py vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
# Shared secret for Django -> AI service tokens (32+ random characters)
AI_SERVICE_SECRET=change-me-ai-service-secret-0123456789
AI_MODERATION_ENABLED=True
AI_DAILY_USER_TOKEN_BUDGET=200000

# Observability (all optional; off while empty, see docs/OPERATIONS.md)
LOG_FORMAT=json
SENTRY_DSN=
# Baked into the client image at build time; the API relays only this DSN.
SENTRY_FRONTEND_DSN=
# e.g. http://otel-collector:4318 with: docker compose --profile observability up -d
OTEL_EXPORTER_OTLP_ENDPOINT=
# Alertmanager receiver (webhook accepting the Alertmanager JSON)
ALERTMANAGER_WEBHOOK_URL=

# Feed candidate cache (Redis)
FEEDCACHE_ENABLED=True
FEEDCACHE_FANOUT_THRESHOLD=1000

# Production overlay only (docker-compose.prod.yml)
# DOMAIN=andromeda.example.com
# ACME_EMAIL=ops@example.com
# IMAGE_REGISTRY=ghcr.io/7irelo
# IMAGE_TAG=1.0.0
