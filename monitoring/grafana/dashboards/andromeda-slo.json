      "targets": [
        {
          "refId": "A",
          "expr": "andromeda:ai_spend_usd:increase1h",
          "legendFormat": "last hour",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(increase(ai_cost_usd_total[7d])) / 168",
          "legendFormat": "weekly hourly average",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
