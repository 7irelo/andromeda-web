    {
      "id": 21,
      "type": "timeseries",
      "title": "Graph drift repaired",
      "description": "Found and repaired by the nightly reconciliation (graph_drift_total{kind}).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 48,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "graph_drift_last_run",
