{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npx ng build",
  "outputDirectory": "dist/andromeda/browser",
  "routes": [
    {
      "src": "/.*",
      "continue": true,
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(self), geolocation=(), payment=()",
        "Cross-Origin-Opener-Policy": "same-origin"
      }
    },
    {
      "src": "/(ngsw-worker\\.js|ngsw\\.json|safety-worker\\.js|worker-basic\\.min\\.js|manifest\\.webmanifest)",
      "continue": true,
      "headers": { "Cache-Control": "no-cache" }
    },
    { "src": "/(api|ws|media|media-upload)(/.*)?", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
